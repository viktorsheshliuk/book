{% if (reviews) %}
{% for review in reviews %}
<div class="review-item">
  <div class="review-heading d-flex">
    <div class="block-author">
    {% if (review['purchased']) %}<span class="purchased"><i title="{{ text_purchased }}" data-toggle="tooltip" class="fa fa-cart-plus" aria-hidden="true"></i></span>{% endif %}
    {{ review['author'] }}
  </div>
    <div class="block-date">
      {{ review['date_added'] }}
    </div>
  </div>
  <div class="review-info">
    <div class="rating">
        {% set i = 1 %}{% for i in i..5 %}
        {% if (review['rating'] < i) %}
        <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
        {% else %}
        <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i></span>
        {% endif %}
        {% endfor %}
      </div>
      <div class="comment">
        {{ review['text'] }}
      </div>
      {% if (show_review_plus and review['plus']) %}
        <div class="review_plus">
          <div><span>{{ text_plus }}</span>
          {{ review['plus'] }}
          </div>
        </div>
      {% endif %}
      {% if (show_review_minus and review['minus']) %}
      <div class="review_minus">
        <div><span>{{ text_minus }}</span>
        {{ review['minus'] }}
      </div>
      </div>
      {% endif %}

      {% if (review['admin_reply'] is defined and review['admin_reply'] != '') %}
        <div class="admin_reply">
          <div>{{ text_admin_reply }}</div>
          {{ review['admin_reply'] }}
        </div>
      {% endif %}
  </div>
</div>
{% endfor %}
<div class="text-center">{{ pagination }}</div>
{% else %}
<p>{{ text_no_reviews }}</p>
{% endif %}
