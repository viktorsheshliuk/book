<div class="container-module">
<div class="title-module"><span>{{ heading_title }}</span></div>
<div class="product-slider">
<div class="container-modules latest_gv latest_grid{{ module }}">
  {% for product in products %}
   <div class="item no-slider {{ class_mob_row }} col-sm-6 col-md-4 col-lg-1-5">
    <div class="product-thumb transition">
      <div class="image">
		{% if (config_on_off_latest_quickview == '1') %}
			<div class="quickview"><button class="btn btn-quickview" data-toggle="tooltip" title="{{ config_quickview_btn_name[lang_id]['config_quickview_btn_name'] }}" onclick="quickview_open({{ product['product_id']}},'{{ all_prod is defined ? all_prod : 0 }}');"><i class="fa fa-eye" aria-hidden="true"></i></button></div>
		{% endif %}
		<div class="stickers-ns">
			{% if ((on_off_sticker_special == '1') and product['special']) %}
				<div class="sticker-ns special">
					{% if (config_change_icon_sticker_special is not empty) %}<i class="fa {{ config_change_icon_sticker_special }} "></i>{% endif %}
					<span>{{ text_sticker_special[lang_id]['config_change_text_sticker_special'] }}</span>
				</div>
			{% endif %}
			{% if ((on_off_sticker_topbestseller == '1') and (product['top_bestsellers'] >= config_limit_order_product_topbestseller)) %}
				<div class="sticker-ns bestseller">
					{% if (config_change_icon_sticker_topbestseller is not empty) %}<i class="fa {{ config_change_icon_sticker_topbestseller }} "></i>{% endif %}
					<span>{{ text_sticker_topbestseller[lang_id]['config_change_text_sticker_topbestseller'] }}</span>
				</div>
			{% endif %}
			{% if ((on_off_sticker_popular == '1') and (product['viewed']>=config_min_quantity_popular)) %}
				<div class="sticker-ns popular">
					{% if (config_change_icon_sticker_popular is not empty) %}<i class="fa {{ config_change_icon_sticker_popular }} "></i>{% endif %}
					<span>{{ text_sticker_popular[lang_id]['config_change_text_sticker_popular'] }}</span>
				</div>
			{% endif %}
			{% if ((on_off_sticker_newproduct == '1') and product.sticker_new_prod ) %}
				<div class="sticker-ns newproduct">
					{% if (config_change_icon_sticker_newproduct is not empty) %}<i class="fa {{ config_change_icon_sticker_newproduct }}"></i>{% endif %}
					{{ text_sticker_newproduct[lang_id]['config_change_text_sticker_newproduct'] }}
				</div>
			{% endif %}
		</div>
		{% if (setting_module['status_additional_image_hover'] is defined and (setting_module['status_additional_image_hover'] == '1')) %}
			<a href="{{ product['href'] }}"><img {% if (product['product_quantity'] <= 0 and show_stock_status) %}data-status="{{ product['stock_status'] }}"{% endif %} {% if (product['additional_image_hover']) %}data-additional-hover="{{ product['additional_image_hover'] }}"{% endif %} {% if (lazyload_module) %}data-src="{{ product['thumb'] }}" src="{{ lazy_image }}" {% else %}src="{{ product['thumb'] }}"{% endif %} alt="{{ product['name'] }}" title="{{ product['name'] }}" class="img-responsive {% if (lazyload_module) %}lazyload{% endif %}" /></a>
		{% else %}
			<a href="{{ product['href'] }}"><img {% if (product['product_quantity'] <= 0 and show_stock_status) %}data-status="{{ product['stock_status'] }}"{% endif %} {% if (lazyload_module) %}data-src="{{ product['thumb'] }}" src="{{ lazy_image }}" {% else %}src="{{ product['thumb'] }}"{% endif %} alt="{{ product['name'] }}" title="{{ product['name'] }}" class="img-responsive {% if (lazyload_module) %}lazyload{% endif %}" /></a>
		{% endif %}
		{% if (show_special_timer_module == '1' and product['special']) %}
			<div class="action-timer">
				<div id="countdown-latestgrid-{{ module }}-{{ product['product_id'] }}"></div>
			</div>
<script>
$(function(){
	var note = $('#note');
	var parts_date ='{{ product['date_end'] }}'.split('-');
	var ts = new Date(parts_date[0], parts_date[1] - 1, parts_date[2]);
	if((new Date()) > ts){
		ts = (new Date()).getTime() + 10*24*60*60*1000;
	}
	$('#countdown-latestgrid-{{ module }}-{{ product['product_id'] }}').countdown({
		timestamp	: ts,
		callback	: function(days, hours, minutes, seconds){
		var message = "";
		message += days;
		message += hours;
		message += minutes;
		message += seconds;
		note.html(message);
		}
	});
});

</script>
		{% endif %}
	  </div>

	  <div class="caption">
        <div class="product-name"><a href="{{ product['href'] }}">{{ product['name'] }}</a></div>
		{% if (setting_module['status_model'] is defined and (setting_module['status_model'] == '1')) %}
			<div class="product-model">{{ product['model']}}</div>
		{% endif %}
		{% if (setting_module['status_description'] is defined and (setting_module['status_description'] == '1')) %}
        <div class="product-description">{{ product['description'] }}</div>
		{% endif %}
		{% if (show_options) %}
				<div id="option_latest_gv_{{ product['product_id'] }}" class="option latest-gv-opt">
				{% for key,option in product['options'] %}
					{% if (option['type'] == 'select') %}
						<div class="form-group">
							<label class="control-label" for="input-option{{ option['product_option_id'] }}">
								{% if (option['required']) %}<i class="fa fa-exclamation-triangle required" data-toggle="tooltip" data-placement="left" title="{{ required_text_option }}"></i>{% endif %}
								{{ option['name'] }}
							</label>
							<div id="input-option-latest{{ option['product_option_id'] }}">
								<select onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" name="option[{{ option['product_option_id'] }}]" id="input-value-{{ option['product_option_id'] }}_latest_gv" class="form-control">
									<option value="">{{ text_select }}</option>
									{% for option_value in option['product_option_value'] %}
									<option data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" value="{{ option_value['product_option_value_id'] }}">{{ option_value['name'] }}
									{% if (option_value['price']) %}
									({{ option_value['price_prefix'] }}{{ option_value['price'] }})
									{% endif %}
									</option>
									{% endfor %}
								</select>
						  </div>
						</div>
					{% endif %}
				{% if (option['type'] == 'radio') %}
				<div class="form-group">
					<label class="control-label" for="input-option{{ option['product_option_id'] }}">
						{% if (option['required']) %}<i class="fa fa-exclamation-triangle required" data-toggle="tooltip" data-placement="left" title="{{ required_text_option }}"></i>{% endif %}
						{{ option['name'] }}
					</label>
				  <div id="input-option-latest{{ option['product_option_id'] }}">
					{% for option_value in option['product_option_value'] %}
						{% if (option_value['image'] or option_value['color']) %}
							{% if (option['status_color_type'] == '1') %}
								<div class="image-radio">
								  <label>
									<input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="radio" name="option[{{ option['product_option_id'] }}]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
										<span for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" class="color-option" data-toggle="tooltip" title="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" style="background-color:{{ option_value['color']}}"></span>
								  </label>
								</div>
							{% else %}
								<div class="image-radio">
								  <label>
									<input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="radio" name="option[{{ option['product_option_id'] }}]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
									<img for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" src="{{ option_value['image'] }}" alt="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" class="img-thumbnail" data-toggle="tooltip" title="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" />
								  </label>
								</div>
							{% endif %}
						{% else %}
							<div class="radio-checbox-options">
								<input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="radio" name="option[{{ option['product_option_id'] }}]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
								<label for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv">
									<span class="option-name">{{ option_value['name'] }}</span>
									{% if (option_value['price']) %}
									<span class="option-price">{{ option_value['price_prefix'] }}{{ option_value['price'] }}</span>
									{% endif %}
								</label>
							</div>
						{% endif %}

					{% endfor %}
				  </div>
				</div>
				{% endif %}

				{% if (option['type'] == 'checkbox') %}
				<div class="form-group">
				  <label class="control-label" for="input-option{{ option['product_option_id'] }}">
						{% if (option['required']) %}<i class="fa fa-exclamation-triangle required" data-toggle="tooltip" data-placement="left" title="{{ required_text_option }}"></i>{% endif %}
						{{ option['name'] }}
					</label>
				  <div id="input-option-latest{{ option['product_option_id'] }}">
					{% for option_value in option['product_option_value'] %}
						{% if (option_value['image'] or option_value['color']) %}
							{% if (option['status_color_type'] == '1') %}
								<div class="image-radio">
								  <label>
									<input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="checkbox" name="option[{{ option['product_option_id'] }}][]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
										<span for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" class="color-option" data-toggle="tooltip" title="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" style="background-color:{{ option_value['color']}}"></span>
								  </label>
								</div>
							{% else %}
								<div class="image-radio">
								  <label>
									<input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="checkbox" name="option[{{ option['product_option_id'] }}][]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
									<img for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" src="{{ option_value['image'] }}" alt="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" class="img-thumbnail" data-toggle="tooltip" title="{{ option_value['name'] ~ option_value['price'] ? ' ' ~ option_value['price_prefix'] ~ option_value['price'] : '' }}" />
								  </label>
								</div>
							{% endif %}
						{% else %}
							<div class="radio-checbox-options">
							  <input data-option-prefix="{{ option_value['price_prefix'] }}" data-option-price="{{ option_value['price_value'] }}" onchange="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" type="checkbox" name="option[{{ option['product_option_id'] }}][]" value="{{ option_value['product_option_value_id'] }}" id="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv" />
								<label for="input-value-{{ option['product_option_id'] }}_{{ option_value['product_option_value_id'] }}_latest_gv">
								<span class="option-name">{{ option_value['name'] }}</span>
									{% if (option_value['price']) %}
									<span class="option-price">{{ option_value['price_prefix'] }}{{ option_value['price'] }}</span>
									{% endif %}
							  </label>
							</div>
						{% endif %}
					{% endfor %}
				  </div>
				</div>
				{% endif %}
			{% endfor %}
			</div>
			{% endif %}
		{% if (setting_module['status_rating'] is defined and (setting_module['status_rating'] == '1')) %}
		<div class="rating">
			<span class="rating-box">
				{% set i = 1 %}{% for i in i..5 %}
					{% if (product['rating'] < i) %}
					<span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span>
					{% else %}
					<span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
					{% endif %}
				{% endfor %}
			{% if (setting_module['status_quantity_reviews'] is defined and (setting_module['status_quantity_reviews'] == '1')) %}
			  <span class="quantity-reviews"><a data-placement="right"  data-toggle="tooltip" title="{{ text_reviews_title }}" href="{{ product['href'] }}#tab-review">{{ product['reviews'] }}</a></span>
			{% endif %}
			</span>
		</div>
		{% endif %}
		<div class="pq-box">
        {% if (product['price']) %}
			<div class="price">
			{% if ((on_off_percent_discount == '1') and product['special']) %}
			<div class="stickers-skidka">
				<div class="sticker-ns procent-skidka">{{ product['skidka'] }} %</div>
			</div>
			{% endif %}
				{% if (not product['special']) %}
				  <span class="price_no_format_{{ product['product_id'] }}">{{ product['price'] }}</span>
				  {% else %}
				  <span class="price-old"><span class="price_no_format_{{ product['product_id'] }}">{{ product['price'] }}</span></span> <span class="price-new"><span class="special_no_format_{{ product['product_id'] }}">{{ product['special'] }}</span></span>
				{% endif %}
			  {% if (product['tax']) %}
			  <span class="price-tax">{{ text_tax }} {{ product['tax'] }}</span>
			  {% endif %}
			</div>
			{% if (setting_module['status_actions'] is not defined) %}
		{% if (config_additional_settings_newstore['quantity_btn_module'] is defined and (config_additional_settings_newstore['quantity_btn_module'] == '1')) %}
			<div class="quantity_plus_minus">
				<input type="text" class="quantity-num form-control input-number-quantity{{ product['product_id'] }}" name="quantity" {% if (config_additional_settings_newstore['quantity_multiple'] is defined and (config_additional_settings_newstore['quantity_multiple'] == '1') and product['minimum'] > 1) %}disabled{% endif %} id="input_quantity_mod_latest_grid{{ module }}{{ product['product_id'] }}" onkeyup="validate_quantity(this,'{{ product['minimum'] }}')" oninput="recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }}, {{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');" value="{{ product['minimum'] }}">
				<span class="quantity-btn">
					<span class="add-up add-action fa fa-angle-up" onclick="btnplus_cat_price_latest_gv{{ module }}{{ product['product_id'] }}('{% if (config_additional_settings_newstore['quantity_multiple'] is defined and (config_additional_settings_newstore['quantity_multiple'] == '1')) %}{{ product['minimum'] }}{% else %}1{% endif %}');"></span>
					<span class="add-down add-action fa fa-angle-down" onclick="btnminus_cat_price_latest_gv{{ module }}{{ product['product_id'] }}('{% if (config_additional_settings_newstore['quantity_multiple'] is defined and (config_additional_settings_newstore['quantity_multiple'] == '1')) %}{{ product['minimum'] }}{% else %}1{% endif %}');"></span>
				</span>
			</div>
			<script>
			{% if (config_additional_settings_newstore['price_recalc'] is defined and (config_additional_settings_newstore['price_recalc'] == '1') and product['minimum'] > 1) %}
				$(window).load(function() {
					recalc_quantity({{ product['product_id'] }},{{ product['minimum'] }},{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');
				});
			{% endif %}
				function btnminus_cat_price_latest_gv{{ module }}{{ product['product_id'] }}(minimum){
					var $input = $('#input_quantity_mod_latest_grid{{ module }}{{ product['product_id'] }}');
					var count = parseInt($input.val()) - parseInt(minimum);
					count = count < parseInt({{ product['minimum'] }}) ? parseInt({{ product['minimum'] }}) : count;
					$input.val(count);
					$input.change();
					recalc_quantity({{ product['product_id'] }},count,{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');
				}
				function btnplus_cat_price_latest_gv{{ module }}{{ product['product_id'] }}(minimum){
					var $input = $('#input_quantity_mod_latest_grid{{ module }}{{ product['product_id'] }}');
					var count = parseInt($input.val()) + parseInt(minimum);
					$input.val(count);
					$input.change();
					recalc_quantity({{ product['product_id'] }},count,{{ product['price_no_format'] }},'{{ product['special_no_format'] }}','.latest_grid{{ module }}','latest_gv');
				};
			</script>
			{% endif %}
			{% endif %}
			{% endif %}
		</div>
		{% if (setting_module['status_actions'] is not defined) %}
		<div class="actions">
			{% if ((product['product_quantity'] <= 0) and disable_cart_button) %}
				<div class="cart"><button class="btn btn-general" type="button" disabled>{% if (change_text_cart_button_out_of_stock == 1) %}<i class="fa fa-lock" aria-hidden="true"></i> <span>{{ disable_cart_button_text }}</span>{% else %}<i class="fa fa-shopping-basket"></i> <span>{{ button_cart }}</span>{% endif %}</button></div>
			{% else %}
				<div class="cart"><button class="btn btn-general" type="button" onclick="cart.add('{{ product['product_id'] }}','latest_gv', get_cart_quantity('{{ product['product_id'] }}','.latest_grid{{ module }}'));">{% if (change_text_cart_button_out_of_stock == 1 and product['product_quantity'] <= 0) %}<i class="fa fa-lock" aria-hidden="true"></i> <i class="fa fa-lock" aria-hidden="true"></i> <span>{{ disable_cart_button_text }}</span>{% else %}<i class="fa fa-shopping-basket"></i> <span>{{ button_cart }}</span>{% endif %}</button></div>
			{% endif %}
			<div class="addit-action">
			{% if (setting_module['status_fastorder'] is defined and (setting_module['status_fastorder'] == '1')) %}
				<div class="quick-order">
					<button class="btn btn-fastorder {% if ((product['product_quantity'] <= 0) and disable_fastorder_button) %}hidden-quick-order{% endif %}" type="button" data-toggle="tooltip" onclick="fastorder_open({{ product['product_id']}});" title="{{ config_text_open_form_send_order[lang_id]['config_text_open_form_send_order'] }}" {% if ((product['product_quantity'] <= 0) and disable_fastorder_button) %}disabled{% endif %}>
						{% if (icon_open_form_send_order != '') %}
							<i class="{{ icon_open_form_send_order }} fa-fw"></i>
						{% else %}
							<i class="fa fa-paper-plane-o fa-fw" aria-hidden="true"></i>
						{% endif %}
					</button>
				</div>
			{% endif %}
			{% if (setting_module['status_wishlist'] is defined and (setting_module['status_wishlist'] == '1')) %}
				<div class="wishlist"><button class="btn btn-wishlist" type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product['product_id'] }}');"><i class="fa fa-heart"></i></button></div>
			{% endif %}
			{% if (setting_module['status_compare'] is defined and (setting_module['status_compare'] == '1')) %}
				<div class="compare"><button class="btn btn-compare" type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product['product_id'] }}');"><i class="fa fa-retweet" aria-hidden="true"></i></button></div>
			{% endif %}
			</div>
		</div>
		{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  </div>
  {% if (status_showmore is defined and status_showmore != 0) %}
	{% if (nextPage) %}
		<div class="showmore-latest{{ module }} box-showmore"><span class="box-ajax-load"><span data-nextpage="{{ nextPage }}" class="latest-ajax-load{{ module }}"><i class="fa fa-repeat" aria-hidden="true"></i> {{ text_showmore }}</span></span></div>
	{% endif %}
	{% endif %}
  </div>
{% if (status_showmore is defined and status_showmore != 0) %}
<script>
$(document).on('click', '.latest-ajax-load{{ module }}', function () {
	$.ajax({
		url: 'index.php?route=extension/module/cyber_latest_grid/getNextPage',
		type: 'post',
		data: 'page=' + $(this).attr('data-nextpage') + '&module={{ module }}&setting={{ setting }}',
		dataType: 'html',
		beforeSend: function() {
			$('.showmore-latest{{ module }} i.fa-repeat').addClass('fa-spin');
		},
		complete: function() {
			$('.showmore-latest{{ module }} i.fa-repeat').removeClass('fa-spin');
		},
		success:function(data){
			$data = $(data);
			var $products = $data.find('.latest_grid{{ module }} > div.item');
			var $product_img = $products.find('a > img');

			$product_img.each(function () {
				if ($(this).attr('data-additional-hover')) {
					var img_src = $(this).attr('data-additional-hover');
					$(this).addClass('main-img');
					$(this).after('<img src="'+img_src+'" class="additional-img-hover img-responsive" title="'+$(this).attr('alt')+'" />');
				}
			});
			$('.latest_grid{{ module }}').append($products);
			$('.showmore-latest{{ module }}').replaceWith($data.find('.showmore-latest{{ module }}'));
		}
	});
})
</script>
{% endif %}
<script>
$('.latest_grid{{ module }}').each(function() {
	if ($(".latest_grid{{ module }}").parents("#column-left, #column-right, .position-no-owl").length) {
		var items = $(this).children('div.item');
		items.removeClass('col-xs-12 col-sm-6 col-md-4 col-lg-3');
		items.addClass('col-xs-12 col-sm-12 col-md-12 col-lg-12');
	}
});
</script>
</div>