			{% if (type_header == 2) %}col-sm-6 text-sm-right{% endif %}
		 	text-xs-left text-md-center
		{% endif %}">
			<div id="phone" {% if (header_phones_dropdown is not empty) %}class="has_drop_list"{% endif %}>
				<div class="contact-header">
					<span class="{% if (type_header == 1) %}hidden-xs{% endif %} header-tel-bicon">
						{% if (header_tel_bicon_image is not empty) %}
						<img class="img-responsive" src="{{ header_tel_bicon_image }}" alt="" />
						{% endif %}
					</span>
					<div class="dropdown-toggle">
						{% for result_hp in config_phones_array %}
							<div class="additional-tel dth">
							{% if (result_hp['type'] is not empty) %}
								<a {{ result_hp['type']}}>
								{% if (result_hp['icon_phone'] != '') %}
									<div class="icon-image"><img src="{{ result_hp['icon_phone'] }}" alt="{{ result_hp['phone'] }}" /></div>
									{% elseif (result_hp['icon'] != '') %}
									<div class="icon-image"><i class="{{ result_hp['icon'] }}"></i></div>
								{% endif %}
								{{ result_hp['phone']}}</a>
							{% else %}
								{% if (result_hp['icon_phone'] != '') %}
									<div class="icon-image"><img src="{{ result_hp['icon_phone'] }}" alt="{{ result_hp['phone'] }}" /></div>
									{% elseif (result_hp['icon'] != '') %}
									<div class="icon-image"><i class="{{ result_hp['icon'] }}"></i></div>
								{% endif %}
								{{ result_hp['phone']}}
							{% endif %}
							</div>
						{% endfor %}
						{% if (header_phones_dropdown is not empty or arbitrary_text[lang_id]['text']) %}
							<span class="drop-icon-info"><i class="car-down fa fa-angle-down"></i></span>
						{% endif %}
					</div>
					{% if (header_phones_dropdown is not empty or arbitrary_text[lang_id]['text']) %}
					<ul class="dropdown-menu drop-contacts">
						{% if (arbitrary_text is defined and (arbitrary_text is not empty)) %}
						<li class="info-contact">
							{{ arbitrary_text }}
						</li>
						<li class="line-contact"></li>
						{% endif %}
						{% if (header_phones_dropdown is not empty) %}
							{% for result_ddh in header_phones_dropdown %}
								<li>
								{% if (result_ddh['type'] is not empty) %}
									<a {{ result_ddh['type']}}>
										{% if (result_ddh['icon_phone'] != '') %}
										<div class="icon-image"><img src="{{ result_ddh['icon_phone'] }}" alt="{{ result_ddh['phone'] }}" /></div>
										{% elseif (result_ddh['icon'] != '') %}
										<div class="icon-image"><i class="{{ result_ddh['icon'] }}"></i></div>
										{% endif %}
										{{ result_ddh['phone'] }}
									</a>
									{% else %}
										<div>
										{% if (result_ddh['icon_phone'] != '') %}
											<div class="icon-image"><img src="{{ result_ddh['icon_phone'] }}" alt="{{ result_ddh['phone'] }}" /></div>
											{% elseif (result_ddh['icon'] != '') %}
											<div class="icon-image"><i class="{{ result_ddh['icon'] }}"></i></div>
											{% endif %}
											{{ result_ddh['phone'] }}
										</div>
									{% endif %}
								</li>
							{% endfor %}
						{% endif %}
					</ul>
					{% endif %}
					{% if (text_after_phone is not empty) %}
					<div class="text_after_phone">{{ text_after_phone }}</div>
					{% endif %}
				</div>
			</div>
		</div>
		{% if (type_header == 2) %}
		<div class="dop-menu-header col-xs-12 col-sm-12 col-md-6 col-lg-6 {% if (swap_header_blocks is defined and (swap_header_blocks == '1')) %}col-md-pull-3 col-lg-pull-3 dopmenu-center{% endif %}">
			{% if (header_doptext is not empty) %}
			<div class="header_dopmenu_doptext">{{ header_doptext }}</div>
			{% endif %}
			{{ cs_dop_menu }}
		</div>
		{% endif %}
		{% if (type_header == 1) %}
		<div class="box-search hidden-sm hidden-xs col-xs-12 col-sm-8 col-md-4 col-lg-5 {% if (swap_header_blocks is defined and (swap_header_blocks == '1')) %} col-md-pull-3 col-lg-pull-2{% endif %} search-top">{{ search }}</div>
		<div class="box-cart {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hidden-xs hidden-sm{% endif %} col-xs-6 col-sm-4 col-md-2 col-lg-2">
			{% if (show_h_compare is defined and (show_h_compare == 1)) %}
				<div class="compare-h">
					<a rel="nofollow" class="btn btn-compare-h" href="{{ compare }}"  id="compare-total" title="{{ text_compare }}">
					<i class="fa fa-retweet" aria-hidden="true"></i><span>{% if (total_compare > 0) %}{{ total_compare }}{% endif %}</span></a>
				</div>
			{% endif %}
			{% if (show_h_wishlist is defined and (show_h_wishlist == 1)) %}
			<div class="wishlist-h">
				<a rel="nofollow" class="btn btn-wishlist-h" href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}">
				<i class="fa fa-heart-o" aria-hidden="true"></i><span>{% if (total_wishlist > 0) %}{{ total_wishlist }}{% endif %}</span></a>
			</div>
			{% endif %}
		{{ cart }}
		</div>
		{% endif %}
	</div>
  </div>
</header>
{% if (megamenu_status) %}
	<div class="{% if (hmenu_type == '1') %}menu-header-box full-mw h-type-{{ type_header }}{% else %}container{% endif %} {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hide-box-menu{% endif %}">
		<div class="{% if (hmenu_type == '1') %}container{% else %}menu-header-box cont-mw h-type-{{ type_header }}{% endif %} {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hide-box-menu{% endif %}">
			<div class="row{% if (config_main_menu_selection == 0) %}{% if (type_header == 2) %} dflex{% endif %}{% endif %}">
				{{ menuvh }}
				{% if (type_header == 2) %}
				<div class="r-h-box dflex pl-0 col-xs-12 {% if (config_main_menu_selection == 1) %}col-md-9{% else %}flex-b-0{% endif %}">
					<div class="search-mob-box {% if (config_main_menu_selection == 1) %}visible-xs{% endif %}"><i class="fa fa-search" aria-hidden="true"></i></div>
					<script>
					$('.search-mob-box').on('click', function() {
						$('.box-search').slideToggle('fast');
					});
					</script>
					<div class="box-search search-top col-sm-8 col-md-9 col-lg-10 {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hidden-xs hidden-sm{% endif %}">{{ search }}</div>
        			<div class="box-account {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hidden-xs hidden-sm{% endif %}">
              			<a data-toggle="dropdown" class="dropdown-toggle btn-account-menu">
              				<i class="fa fa-user-circle"></i>
              				<div class="info-auth-user hidden-xs {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hidden-sm{% endif %}">
              					<span class="text-hello">{{ text_hello }}</span>
                  				<span class="name-auth">
                  			{% if (logged) %}
			                	{{ last_name~' '~first_name }}
			                {% else %}
			                	{{ text_login_auth }}
			                {% endif %}
                  			</span>
							</div>
                  		</a>
                  		<ul class="dropdown-menu dropdown-menu-right">
			                {% if (logged) %}
			                <li><a rel="nofollow" href="{{ account }}">{{ text_account }}</a></li>
			                <li><a rel="nofollow" href="{{ order }}">{{ text_order }}</a></li>
			                <li><a rel="nofollow" href="{{ transaction }}">{{ text_transaction }}</a></li>
			                <li><a rel="nofollow" href="{{ download }}">{{ text_download }}</a></li>
			                <li><a rel="nofollow" href="{{ logout }}">{{ text_logout }}</a></li>
			                {% else %}
			                <li><a rel="nofollow" href="{{ register }}">{{ text_register }}</a></li>
			                <li><a rel="nofollow" href="javascript:void(0)" id="login-popup" data-load-url="index.php?route=common/login_modal">{{ text_login }}</a></li>
			                {% endif %}
			            </ul>
         		 	</div>
					<div class="box-cart col-xs-12 col-sm-4 col-md-3 col-lg-2 {% if (main_menu_fix_mobile is defined and (main_menu_fix_mobile == 1)) %}hidden-xs hidden-sm{% endif %}">
						{% if (show_h_compare is defined and (show_h_compare == 1)) %}
							<div class="compare-h">
								<a rel="nofollow" class="btn btn-compare-h" href="{{ compare }}"  id="compare-total" title="{{ text_compare }}">
								<i class="fa fa-retweet" aria-hidden="true"></i><span>{% if (total_compare > 0) %}{{ total_compare }}{% endif %}</span></a>
							</div>
						{% endif %}
						{% if (show_h_wishlist is defined and (show_h_wishlist == 1)) %}
						<div class="wishlist-h">
							<a rel="nofollow" class="btn btn-wishlist-h" href="{{ wishlist }}" id="wishlist-total" title="{{ text_wishlist }}">
							<i class="fa fa-heart-o" aria-hidden="true"></i><span>{% if (total_wishlist > 0) %}{{ total_wishlist }}{% endif %}</span></a>
						</div>
						{% endif %}
						{{ cart }}
					</div>
				</div>
				{% endif %}

			</div>
		</div>
	</div>
{% endif %}